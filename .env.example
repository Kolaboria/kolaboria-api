# App Configuration
APP_NAME=kolaboria-api
APP_ENV=development
APP_PORT=8081
APP_DEBUG=true
APP_FRONTEND_URL=
APP_ALLOW_ORIGINS=
# Leave empty to allow all origins. Use comma-separated values to whitelist:
# APP_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kolaboria
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Jakarta
DB_MAX_OPEN_CONNS=100

WORKSPACE_OVERVIEW_ENABLED=true
WORKSPACE_OVERVIEW_MAX_REQUESTS=64
WORKSPACE_OVERVIEW_MAX_SNAPSHOTS=8
WORKSPACE_OVERVIEW_REQUEST_TIMEOUT_MS=2000
WORKSPACE_OVERVIEW_SNAPSHOT_TIMEOUT_MS=1500
WORKSPACE_OVERVIEW_STATEMENT_TIMEOUT_MS=750
WORKSPACE_OVERVIEW_LOCK_TIMEOUT_MS=150

# JWT Configuration
JWT_SECRET=change-this-to-a-long-random-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# Mail Configuration (SMTP)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=your_username
MAIL_PASSWORD=your_password
MAIL_FROM_NAME=Kolaboria
MAIL_FROM_EMAIL=noreply@kolaboria.com
# Publicly reachable HTTPS URL for the logo in email headers (required by Gmail/remote recipients).
# Leave empty only when APP_FRONTEND_URL is also publicly reachable; otherwise set a deployed or tunnel URL.
MAIL_LOGO_URL=
